generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  password    String?
  googleId    String?      @unique
  avatarUrl   String?
  refreshTokens RefreshToken[]
  role        String       @default("CUSTOMER")
  restaurants Restaurant[] // an OWNER can have many restaurants
  bookings    Booking[]    // A USER can make many bookings
  isVerified               Boolean   @default(false)
  verificationToken        String?   // Stores the 6-digit OTP
  verificationTokenExpires DateTime? // Expiration timestamp
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}
model Restaurant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  cuisine     String
  startingPrice Float?
  capacity      Int?     // Total number of people the restaurant can seat
  address     String
  city        String
  state       String?
  country     String   @default("Nigeria")

  email       String   @unique
  phoneNumber String

  logoUrl     String?
  coverImage  String?

  isActive    Boolean  @default(true)
  isVerified  Boolean  @default(false)

  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])

  bookings       Booking[]
  availabilities RestaurantAvailability[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([city])
  @@index([ownerId])
}

model Booking {
  id             String     @id @default(cuid())
  bookingDate    DateTime
  bookingTime    String     // e.g., "19:00"
  numberOfPeople Int
  status         String     @default("PENDING") // PENDING, CONFIRMED, CANCELLED, REJECTED
  specialRequests String?

  userId         String?
  user           User?      @relation(fields: [userId], references: [id])
  
  guestName      String
  guestEmail     String
  guestPhone     String

  isVerified               Boolean   @default(false)
  verificationToken        String?
  verificationTokenExpires DateTime?
  reminderSent             Boolean   @default(false)

  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id])

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([userId])
  @@index([restaurantId])
}

model RestaurantAvailability {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  date         DateTime   @db.Date // Specific calendar date (e.g., 2026-07-01)
  timeSlots    Json       // Array of objects: [{ time: "18:00", capacity: 20 }]

  @@unique([restaurantId, date])
}