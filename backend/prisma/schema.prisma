generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  password    String?
  refreshTokens RefreshToken[]
  role        String       @default("CUSTOMER")
  restaurants Restaurant[] // an OWNER can have many restaurants
  bookings    Booking[]    // A USER can make many bookings
  isVerified               Boolean   @default(false)
  verificationToken        String?   // Stores the 6-digit OTP
  verificationTokenExpires DateTime? // Expiration timestamp
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}
model Restaurant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  cuisine     String
  startingPrice Float?
  openingTime   String?  // e.g., "09:00"
  closingTime   String?  // e.g., "22:00"
  capacity      Int?     // Total number of people the restaurant can seat
  address     String
  city        String
  state       String?
  country     String   @default("Nigeria")

  email       String   @unique
  phoneNumber String

  logoUrl     String?
  coverImage  String?

  isActive    Boolean  @default(true)
  isVerified  Boolean  @default(false)

  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])

  bookings    Booking[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([city])
  @@index([ownerId])
}

model Booking {
  id             String     @id @default(cuid())
  bookingDate    DateTime
  bookingTime    String     // e.g., "19:00"
  numberOfPeople Int
  status         String     @default("PENDING") // PENDING, CONFIRMED, CANCELLED, REJECTED
  specialRequests String?

  userId         String
  user           User       @relation(fields: [userId], references: [id])

  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id])

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([userId])
  @@index([restaurantId])
}