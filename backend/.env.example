# ─── Database ────────────────────────────────────────────────────────────────
# Supabase transaction-mode pooler connection string (with ?pgbouncer=true)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# Supabase session-mode pooler connection string (used for migrations only)
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET="your-jwt-secret-here"

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="https://your-worker.your-subdomain.workers.dev/auth/google/callback"

# ─── Email ───────────────────────────────────────────────────────────────────
SENDBYTE_API_KEY="your-sendbyte-api-key"
